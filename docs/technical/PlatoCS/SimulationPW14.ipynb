    "ax[0].plot(df0.time, df0.flux + 1000, ',', c='k', ms=1, alpha=0.1, label='Raw LC')\n",
    "ax[0].plot(df0.time, df0.flux_detrend, ',', c='royalblue', ms=1,   alpha=0.1, label='Detrended LC')\n",
    "ax[0].plot(df_dsct.time, df_dsct.flux - 1000, '-', c='orange',    lw=0.2, alpha=1, label='Input model')\n",
    "ax[0].set_ylabel('Flux [ppt]')\n",
    "ax[0].set_xlim(np.min(df0.time), np.max(df0.time))\n",
    "ax[0].set_ylim(-2500, 2100)\n",
    "ax[0].legend(ncol=3, loc='lower left')\n",
    "\n",
    "ax[1].plot(df_dsct.time, df_dsct.flux, '-', c='orange',    lw=0.2, alpha=1.0, label='Input model')\n",
    "ax[1].plot(df0.time, df0.flux,         '.', c='k',         ms=2,   alpha=0.2, label='Raw LC')\n",
    "ax[1].plot(df0.time, df0.flux_detrend, '.', c='royalblue', ms=2,   alpha=0.2, label='Detrended LC')\n",
    "ax[1].set_ylabel('Flux [ppt] (Zoom-in)')\n",
    "ax[1].set_xlim(83, 97)\n",
