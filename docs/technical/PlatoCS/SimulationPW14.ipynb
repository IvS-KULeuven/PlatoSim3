    "ax[0].plot(lc1.time(), lc1.flux(unit='ppt'), ',', c='orange',    ms=0.8, alpha=0.8, label=r'Algol$_{\\rm faint}$ + roAp$_{\\rm bright}$')\n",
    "ax[0].plot(lc2.time(), lc2.flux(unit='ppt'), ',', c='royalblue', ms=0.8, alpha=0.8, label=r'roAp$_{\\rm faint}$ + algol$_{\\rm bright}$')\n",
    "ax[0].set_xlim(np.min(lc0.time()), np.max(lc0.time()))\n",
    "ax[0].set_ylim(-500, 800)\n",
    "ax[0].legend(ncol=3)\n",
    "ax[0].set_ylabel('Flux [ppt] (full)')\n",
    "# ax[0].set_title(r'$\\gamma$ Dor: cadence of 50s')\n",
    "\n",
    "ax[1].plot(lc0.time(), lc0.flux(unit='ppt'), '.', c='k',         ms=2, alpha=1)\n",
    "ax[1].plot(lc1.time(), lc1.flux(unit='ppt'), '.', c='orange',    ms=1, alpha=1)\n",
    "ax[1].plot(lc2.time(), lc2.flux(unit='ppt'), '.', c='royalblue', ms=0.5, alpha=1)\n",
