    "# Plot comparison figure\n",
    "fig, ax = plt.subplots(4, 1, figsize=(10,12))\n",
    "plt.suptitle(r'$\\delta$ Sct cluster member: $V=12.51$, cadence of 600s', fontsize=22)\n",
    "\n",
    "ax[0].plot(lc0.time(), lc0.flux(unit='ppt'), '.', c='k',         ms=0.5, label=r'$\\delta$ Sct$_{\\rm only}$')\n",
    "ax[0].plot(lc1.time(), lc1.flux(unit='ppt'), '.', c='orange',    ms=0.5, label=r'Algol$_{\\rm faint}$ + roAp$_{\\rm bright}$')\n",
    "ax[0].plot(lc2.time(), lc2.flux(unit='ppt'), '.', c='royalblue', ms=0.5, label=r'roAp$_{\\rm faint}$ + algol$_{\\rm bright}$')\n",
    "ax[0].set_xlim(np.min(lc0.time()), np.max(lc0.time()))\n",
    "ax[0].set_ylim(-500, 800)\n",
    "ax[0].legend(ncol=3)\n",
    "ax[0].set_ylabel('Flux [ppt] (full)')\n",
    "\n",
    "ax[1].plot(lc0.time(), lc0.flux(unit='ppt'), '.', c='k',         ms=3)\n",
    "ax[1].plot(lc1.time(), lc1.flux(unit='ppt'), '.', c='orange',    ms=2)\n",
    "ax[1].plot(lc2.time(), lc2.flux(unit='ppt'), '.', c='royalblue', ms=2)\n",
    "ax[1].set_xlim(0, 15)\n",
    "ax[1].set_ylim(-500, 500)\n",
    "ax[1].set_ylabel('Flux [ppt]')\n",
    "\n",
    "ax[2].plot(lc1.time(), lc1.flux(unit='ppt')-lc0.flux(unit='ppt'), '.', c='orange', ms=4, \n",
    "           label=r'$\\delta$ Sct$_{\\rm only}$ - (Algol$_{\\rm faint}$ + roAp$_{\\rm bright}$)')\n",
    "ax[2].plot(lc1.time(), res1_med, '-', c='k', lw=2, label='10h moving median')\n",
    "ax[2].set_xlim(0, 15)\n",
    "ax[2].set_ylim(-15, 8)\n",
    "ax[2].set_ylabel('Residuals [ppt]')\n",
    "ax[2].legend(ncol=2)\n",
    "\n",
