    "res1_med = scipy.ndimage.median_filter(lc1.flux(unit='ppt')-lc0.flux(unit='ppt'), int(6*3600/50))\n",
    "res2_med = scipy.ndimage.median_filter(lc2.flux(unit='ppt')-lc0.flux(unit='ppt'), int(1*3600/50))"
