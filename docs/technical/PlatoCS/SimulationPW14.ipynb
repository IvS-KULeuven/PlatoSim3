    "lcs = LightCurve(odir, mode=\"multi\")\n",
    "filenames = lcs.files(\"hdf5\", \"sim11\")\n",
    "lc0 = LightCurve(filenames[0])\n",
    "lc1 = LightCurve(filenames[1])\n",
    "lc2 = LightCurve(filenames[2])\n",
