    "df1 = pd.DataFrame()\n",
    "df0 = pd.DataFrame()\n",
    "for f in filenames:\n",
    "    lc = LightCurve(f)\n",
    "    df1['time'] = lc.time()\n",
    "    df1['flux'] = lc.flux(unit='ppt')\n",
    "    # Stitch the light curve\n",
    "    lc = LightCurve(df1, mode=\"multi\")\n",
    "    df1 = lc.detrend(model='poly', degree=2)\n",
    "    df0 = pd.concat([df0, df1])"
   ]
